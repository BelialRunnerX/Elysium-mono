### Elysium ###
# Where `gradlew collectJars` gathers the four mod jars. Generated, and CI
# uploads the same set as a run artifact.
dist/

# Each mod's file-based maven, written by `gradlew publish`. Only needed when
# building a mod on its own; the composite build substitutes the library from
# source and never reads these.
repo/

# Generated by elysium-lib/ui/screens.py.
ui/preview/
__pycache__/
