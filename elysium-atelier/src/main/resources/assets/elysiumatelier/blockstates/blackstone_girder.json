{
  "multipart": [
    {
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_side_alt"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_noside"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_noside_alt"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "elysiumatelier:block/blackstone_girder_noside",
        "y": 270
      }
    }
  ]
}
